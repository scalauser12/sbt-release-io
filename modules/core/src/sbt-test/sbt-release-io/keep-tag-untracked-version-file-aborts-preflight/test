# Initialize a repository with version.sbt deliberately left untracked.
$ exec git init
$ exec git config user.email "test@example.com"
$ exec git config user.name "Test User"
$ exec git add .gitignore build.sbt project/plugins.sbt
$ exec git commit -m "Initial commit (version.sbt deliberately untracked)"

# The existing tag points at HEAD, but the release must add version.sbt in a new commit.
$ exec git tag -a v0.1.0 -m "existing release tag"

# Keeping the existing tag is invalid and must abort before the release commit mutates HEAD.
-> releaseIO with-defaults default-tag-exists-answer k release-version 0.1.0 next-version 0.2.0-SNAPSHOT

> checkPreflightAborted
