# Initialize a repository with one eligible custom publisher and one skipped mismatched child.
$ exec git init
$ exec git config user.email "test@example.com"
$ exec git config user.name "Test User"
$ exec git add .gitignore build.sbt version.sbt project/plugins.sbt
$ exec git commit -m "Initial commit"

# The skipped child's custom action ignores publish / skip, but its scoped task must still be
# filtered from the selected publish graph. Its independent version is therefore harmless.
> releaseIO with-defaults release-version 0.1.0 next-version 0.2.0-SNAPSHOT

$ exists eligible/eligible-published.marker
$ absent skipped/skipped-published.marker
$ exec git rev-parse --verify refs/tags/v0.1.0
$ exec grep -q '0.2.0-SNAPSHOT' version.sbt
